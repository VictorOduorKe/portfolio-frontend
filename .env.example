# ==============================================================================
# TheTechCraft Portfolio - Frontend Environment Variables (.env)
# ==============================================================================
# In production on HostPinnacle cPanel:
# The frontend is hosted at: https://thetechcraft.co.ke
# The backend API is hosted at: https://backend.thetechcraft.co.ke/api
#
# During the GitHub Actions production build, VITE_API_URL is supplied as:
# VITE_API_URL=https://backend.thetechcraft.co.ke/api
#
# DO NOT place backend secrets, database passwords, SMTP passwords, or Gemini API keys in this file.
# Any variable prefixed with VITE_ is statically bundled into client-side JavaScript and publicly visible!
# ==============================================================================

# Local development backend URL (proxied by Vite or direct localhost)
VITE_API_URL=http://localhost:8000

# Production public API endpoint
# VITE_API_URL=https://backend.thetechcraft.co.ke/api
