# ==============================================================================
# TheTechCraft Portfolio - Production Apache (.htaccess)
# Designed for HostPinnacle cPanel shared hosting
# ==============================================================================

Options -Indexes

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Redirect www.* to non-www canonical host
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # 3. Pass Authorization Header through CGI/FastCGI to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 4. Redirect legacy frontend /api requests to the separate backend subdomain
    RewriteRule ^api(/.*)?$ https://backend.thetechcraft.co.ke/api$1 [R=301,L]

    # 5. Allow existing files and directories to be served directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. Return 404 for missing static assets instead of loading the SPA index.html
    RewriteCond %{REQUEST_URI} \.(css|js|map|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot|pdf|json|txt|xml)$ [NC]
    RewriteRule ^ - [R=404,L]

    # 7. React Router SPA fallback for all frontend routes (/, /news, /admin, etc.)
    RewriteRule ^ index.html [L]
</IfModule>
